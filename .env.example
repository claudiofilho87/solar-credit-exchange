# Get both from Neon (neon.tech) or Vercel's Storage tab (Postgres, powered by Neon).
# DATABASE_URL: pooled connection, used by the app.
# DATABASE_URL_UNPOOLED: direct connection, used only by `prisma migrate`/`prisma studio`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional: without this key, the impact briefing falls back to static text (see lib/gemini.ts)
GEMINI_API_KEY=
